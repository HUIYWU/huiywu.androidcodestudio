<?xml version="1.0" encoding="utf-8"?>
<!--
  One answer.

  The prose and the file-change rows are not separate list items: blocks are inflated into
  @id/blockContainer inside this row. Splitting them into items would make "which blocks belong to
  which answer" a property of item ordering, which DiffUtil then has to be kept honest about; keeping
  them nested makes the answer the unit of update, and it is the unit the agent actually produces.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/blockContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>