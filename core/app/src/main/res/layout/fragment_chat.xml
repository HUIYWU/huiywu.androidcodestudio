<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat page of the AI sidebar.

  Composer:
  - The composer is a single rounded card (surfaceContainerHigh, 24dp corners, 3dp elevation) that
    holds both the prompt field and the action row. The field itself paints nothing - it is
    background=@null - so the card is the only surface and the block cannot read as two stacked panels.
  - The model chip shares the action row with the clear/send buttons. The buttons are icon-only - the
    text was removed, the buttons were not - and they are pinned to 48dp so the row cannot squeeze them
    off screen.

  Model picker:
  - The Chip is the only control: it shows the model in effect, and its click toggles the model menu.
    The menu is a ListPopupWindow owned by ChatFragment, anchored to the chip, so the framework still
    places it and flips it up when there is no room below.
  - There is deliberately no field behind the chip. An AutoCompleteTextView used as the menu owner
    paints the selected model as its own text (MaterialAutoCompleteTextView calls setText() from its
    internal item-click listener), so the value leaked out beside the chip whenever the chip was
    narrower than the name.
  - The menu lists the models of the provider currently selected; picking one switches the model within
    that provider.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <!-- Tinted from the theme: the drawable's own fill colour is white, which disappears on a
                 light background. -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.5"
                android:contentDescription="@string/ai_agent_title"
                android:src="@drawable/ic_ai"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/chat_prompt_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/composerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:paddingBottom="4dp">

                <!-- The card is the only surface here, so the field carries no background of its own.
                     @null rather than no attribute: the theme's editTextStyle would otherwise put its
                     own box back. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/promptInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/ai_agent_prompt_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modelChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxWidth="200dp"
                        android:singleLine="true" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearBtn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/clear"
                        app:icon="@drawable/ic_clear" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendBtn"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/send"
                        app:icon="@drawable/ic_send" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>