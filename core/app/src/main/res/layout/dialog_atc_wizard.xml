<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">

    <LinearLayout
      android:id="@+id/wizardContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

      <!-- Page 1: Template Selection -->
      <LinearLayout
        android:id="@+id/pageTemplates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/choose_template"
          android:textAppearance="?attr/textAppearanceHeadlineSmall"
          android:layout_marginBottom="16dp"
          android:gravity="center" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/templatesGrid"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false" />
      </LinearLayout>

      <!-- Page 2: Options -->
      <LinearLayout
        android:id="@+id/pageOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/project_configuration"
          android:textAppearance="?attr/textAppearanceHeadlineSmall"
          android:layout_marginBottom="16dp"
          android:gravity="center" />

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/projectNameLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/project_name"
          app:startIconDrawable="@drawable/ic_android">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/projectNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_project_name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/package_name"
          app:startIconDrawable="@drawable/ic_package">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/packageNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_package_name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/saveLocationLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/project_location"
          app:endIconMode="custom"
          app:endIconDrawable="@drawable/ic_folder"
          app:endIconContentDescription="@string/browse">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/saveLocationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/languageInputLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/language"
          app:startIconDrawable="@drawable/ic_language_kotlin"
          style="@style/AppTheme.TextInputLayout.Dropdown">

          <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/languageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            app:simpleItemSelectedColor="?attr/colorSecondaryContainer"
            app:simpleItemSelectedRippleColor="?attr/colorSecondaryContainer" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/minSdkInputLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/minimum_sdk"
          app:startIconDrawable="@drawable/ic_min_sdk"
          style="@style/AppTheme.TextInputLayout.Dropdown">

          <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/minSdkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            app:simpleItemSelectedColor="?attr/colorSecondaryContainer"
            app:simpleItemSelectedRippleColor="?attr/colorSecondaryContainer" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/nativeLanguageInputLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:visibility="gone"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:hint="@string/native_language"
          app:startIconDrawable="@drawable/ic_language_cpp"
          style="@style/AppTheme.TextInputLayout.Dropdown">

          <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/nativeLanguageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            app:simpleItemSelectedColor="?attr/colorSecondaryContainer"
            app:simpleItemSelectedRippleColor="?attr/colorSecondaryContainer" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/ndkVersionButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:visibility="gone"
          android:text="@string/ndk_version_auto"
          style="@style/Widget.Material3.Button.OutlinedButton"
          app:icon="@drawable/ic_settings"
          app:iconGravity="start" />

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/useKtsSwitch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:checked="false"
          android:text="@string/use_gradle_kotlin_dsl" />
          
        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/useCMakeSwitch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:visibility="gone"
          android:layout_marginBottom="8dp"
          android:checked="true"
          android:text="@string/use_cmake" />

        <!-- Actions are fixed at the bottom of the sheet. -->
      </LinearLayout>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

    <LinearLayout
      android:id="@+id/actionsContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:orientation="horizontal"
      android:paddingStart="24dp"
      android:paddingTop="12dp"
      android:paddingEnd="24dp"
      android:paddingBottom="16dp"
      android:visibility="gone">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton" />

      <Space
        android:layout_width="8dp"
        android:layout_height="wrap_content" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/createButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</layout>